# Database — local Docker Postgres (docker compose up -d)
# Or Railway Postgres URL in production
DATABASE_URL="postgresql://leadflow:leadflow@localhost:5432/leadflow?schema=public"

# Auth — REQUIRED. Generate with: openssl rand -base64 48
# Signs session cookies. In production the app refuses to start with a missing,
# short (<32 char), or previously published value.
JWT_SECRET=""

# Optional: separate key for encrypting stored SMTP passwords.
# Defaults to JWT_SECRET. Same strength rules apply.
SMTP_SECRET=""

# First super admin. Only used when the account does not already exist —
# a deploy will never reset an existing password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Set to "true" ONLY in local dev to seed demo@leadflow.us / admin@leadflow.us
SEED_DEMO=""

# AI Provider
OPENAI_API_KEY=""

# Lead Data Sources (required for live lead generation)
GOOGLE_PLACES_API_KEY=""
YELP_FUSION_API_KEY=""

# Optional enrichment
# Public web search fallback for verified Nextdoor/Houzz profiles (serper.dev)
SERPER_API_KEY=""
HOUZZ_SEARCH_ENDPOINT=""
HOUZZ_API_KEY=""
NEXTDOOR_SEARCH_ENDPOINT=""
NEXTDOOR_API_KEY=""
LINKEDIN_DATA_API_KEY=""
# Prefer NinjaPear (Proxycurl is shut down). Same key works in either env name:
NINJAPEAR_API_KEY=""

# Meta / Facebook Ads Library, page search, and user profile sync (OAuth)
META_APP_ID=""
META_APP_SECRET=""
# Optional: long-lived user access token with ads_archive / Ads Library access
META_ACCESS_TOKEN=""
# In Meta Developer → Facebook Login → Valid OAuth Redirect URIs, add:
#   {NEXT_PUBLIC_APP_URL}/api/integrations/facebook/callback
# e.g. https://www.contractorleads.us/api/integrations/facebook/callback
# App type should allow public_profile, email, pages_show_list.

# Transactional email (signup verification) — set one of:
RESEND_API_KEY=""
# RESEND_FROM="Contractor Leads <onboarding@yourdomain.com>"
SENDGRID_API_KEY=""
# EMAIL_FROM="Contractor Leads <hello@yourdomain.com>"

# App URL (required for verification email links + Stripe return URLs)
# Production MUST be https://www.contractorleads.us — never localhost or Railway *.up.railway.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public SEO always uses https://www.contractorleads.us (sitemap, robots, canonicals).
# Apex contractorleads.us redirects to www via middleware.
# After deploy: Google Search Console → add Domain property → submit sitemap:
#   https://www.contractorleads.us/sitemap.xml
# Optional social profiles (Organization sameAs + footers). Defaults to the founder's profiles.
# Point these at brand pages once they exist.
# NEXT_PUBLIC_SOCIAL_LINKEDIN="https://www.linkedin.com/company/your-page"
# NEXT_PUBLIC_SOCIAL_FACEBOOK="https://www.facebook.com/your-page"

# Stripe Billing (Starter / Growth / Agency Checkout)
STRIPE_SECRET_KEY=""
# Public browser key (pk_test_... or pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional, but required for automatic plan/credit/email webhook updates
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_AGENCY=""
STRIPE_PRICE_AGENCY_ANNUAL=""
# $30/mo Messaging add-on (unlocks bulk email + SMS). Also settable in Admin → System.
STRIPE_PRICE_MESSAGING=""

# Twilio SMS (Messaging add-on). Also settable in Admin → System.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# E.164 number you bought in Twilio, e.g. +15551234567
TWILIO_FROM_NUMBER=""
# Optional: Messaging Service SID (MG…) — preferred over TWILIO_FROM_NUMBER when set
# TWILIO_MESSAGING_SERVICE_SID=""
# Webhook URL to paste in Twilio Console: {NEXT_PUBLIC_APP_URL}/api/webhooks/twilio/sms

# Background jobs & inbound mail — sent as: Authorization: Bearer <secret>
CRON_SECRET=""
INBOUND_EMAIL_SECRET=""

# Railway checklist (product APIs — no MCP server):
# DATABASE_URL, JWT_SECRET, NEXT_PUBLIC_APP_URL,
# GOOGLE_PLACES_API_KEY (Places + Autocomplete enabled + billing),
# YELP_FUSION_API_KEY, OPENAI_API_KEY,
# META_ACCESS_TOKEN (long-lived), NINJAPEAR_API_KEY (nubela.co — not Proxycurl),
# RESEND_API_KEY or SENDGRID_API_KEY,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_STARTER|GROWTH|AGENCY,
# TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/billing/webhook
# SMS webhook: {NEXT_PUBLIC_APP_URL}/api/webhooks/twilio/sms